<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.aihub</groupId>
        <artifactId>aihub-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>aihub-bootstrap</artifactId>
    <dependencies>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.aihub</groupId>
            <artifactId>aihub-chat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
              <version>11.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
             <version>11.19.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.aihub.bootstrap.AIHubApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
